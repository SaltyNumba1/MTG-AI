# MTG Collection - backend env
# Switch which Ollama model the deck engine calls.

# v1 - Mistral 7B (current daily driver - fast on CPU-only systems)
OLLAMA_MODEL=mtg-commander

# v2 - Mistral-Nemo 12B (smarter but needs GPU for usable speeds)
# OLLAMA_MODEL=mtg-commander-nemo
# OLLAMA_MODEL=mtg-commander-nemo-q3

# Generous timeout for AI deck generation (15 min)
OLLAMA_TIMEOUT=900
