# MTG Collection - backend env
# Switch which Ollama model the deck engine calls.

# v1 - Mistral 7B (current daily driver - fast on CPU-only systems)
OLLAMA_MODEL=mtg-commander

# v2 - Mistral-Nemo 12B (smarter but needs GPU for usable speeds)
# OLLAMA_MODEL=mtg-commander-nemo
# OLLAMA_MODEL=mtg-commander-nemo-q3

# HTTP client timeout for the Ollama call (seconds). Should be >= MAX_GENERATION_SEC.
OLLAMA_TIMEOUT=1800

# Hard cap on how long a single LLM generation may stream before being aborted.
# Default in code is 420s (7 min), which is too short for CPU-only Mistral 7B builds with
# large collections / must-includes. Bumped to 1800s (30 min).
OLLAMA_MAX_GENERATION_SEC=1800

# Max tokens the model will generate per request. Lower = faster but riskier truncation.
OLLAMA_NUM_PREDICT=768
